@always_inline
def small(x: Int) -> Int:
    return x * 2 + 1


def big(x: Int) -> Int:
    var s = 0
    s += x * 0
    s += x * 1
    s += x * 2
    s += x * 3
    s += x * 4
    s += x * 5
    s += x * 6
    s += x * 7
    s += x * 8
    s += x * 9
    s += x * 10
    s += x * 11
    s += x * 12
    s += x * 13
    s += x * 14
    s += x * 15
    s += x * 16
    s += x * 17
    s += x * 18
    s += x * 19
    s += x * 20
    s += x * 21
    s += x * 22
    s += x * 23
    s += x * 24
    s += x * 25
    s += x * 26
    s += x * 27
    s += x * 28
    s += x * 29
    s += x * 30
    s += x * 31
    s += x * 32
    s += x * 33
    s += x * 34
    s += x * 35
    s += x * 36
    s += x * 37
    s += x * 38
    s += x * 39
    s += x * 40
    s += x * 41
    s += x * 42
    s += x * 43
    s += x * 44
    s += x * 45
    s += x * 46
    s += x * 47
    s += x * 48
    s += x * 49
    s += x * 50
    s += x * 51
    s += x * 52
    s += x * 53
    s += x * 54
    s += x * 55
    s += x * 56
    s += x * 57
    s += x * 58
    s += x * 59
    s += x * 60
    s += x * 61
    return s


def main():
    print(small(1) + small(2) + big(1) + big(2))
